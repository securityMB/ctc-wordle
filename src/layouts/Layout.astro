---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CTC Wordle Archive — Wordle in a Minute',
  description = 'Complete searchable archive of Cracking The Cryptic Wordle in a Minute solves with stats, colored guess tiles, solve times, and SQL explorer.',
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isSqlPage = pathname === '/sql-explorer';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />
    <script>
      try {
        const saved = localStorage.getItem('ctc-wordle-theme');
        const prefersDark =
          typeof window.matchMedia === 'function' &&
          window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch {
        // Ignore storage errors
      }
    </script>
  </head>
  <body>
    <div class="page-sheet">
      <header class="site-header">
        <div class="hero-block">
          <a href="/" class="brand-link" tabindex="-1">
            <div class="brand-tiles" aria-hidden="true">
              <span class="brand-tile green">C</span>
              <span class="brand-tile yellow">T</span>
              <span class="brand-tile green">C</span>
            </div>
            <h1 class="brand-title">CTC Wordle Archive</h1>
          </a>
        </div>

        <nav class="site-nav" aria-label="Main navigation">
          <ul class="nav-list">
            <li class="nav-tabs-group">
              <a href="/" class={`nav-link${!isSqlPage ? ' active' : ''}`} aria-current={!isSqlPage ? 'page' : undefined}>
                Archive
              </a>
              <a
                href="/sql-explorer"
                class={`nav-link${isSqlPage ? ' active' : ''}`}
                aria-current={isSqlPage ? 'page' : undefined}
              >
                SQL Explorer
              </a>
            </li>
            <li>
              <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme">
                <span id="theme-icon" aria-hidden="true">◐</span>
                <span id="theme-label">Dark</span>
              </button>
            </li>
          </ul>
        </nav>

        <section class="intro-prose">
          <p>
            Every <strong>Wordle in a Minute</strong> solve from{' '}
            <a href="https://www.youtube.com/@CrackingTheCryptic" target="_blank" rel="noopener noreferrer">
              Cracking The Cryptic
            </a>{' '}
            with full guess boards, solve times, and a browser-based SQLite explorer.
          </p>
          <p class="intro-disclaimer">
            This is a fan-made project and is not affiliated with Cracking The Cryptic. Guesses and solve
            times are extracted automatically from videos using computer vision, a custom ML classifier,
            and a VLM, so occasional inaccuracies may occur. Source code on{' '}
            <a href="https://github.com/securityMB/ctc-wordle" target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
            .
          </p>
        </section>
      </header>

      <main class="main-content">
        <slot />
      </main>
    </div>

    <script>
      const btn = document.getElementById('theme-toggle');
      const label = document.getElementById('theme-label');

      function syncLabel(): void {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        if (label) label.textContent = current === 'dark' ? 'Light' : 'Dark';
      }

      syncLabel();
      btn?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('ctc-wordle-theme', next);
        } catch {
          // Ignore storage errors
        }
        syncLabel();
      });
    </script>
  </body>
</html>
