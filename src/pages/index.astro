---
import Layout from '#src/layouts/Layout.astro';
import StatsBar from '#src/components/StatsBar.astro';
import GamesTable from '#src/components/GamesTable.tsx';
import { loadAllGames } from '#lib/games.ts';

const allGames = loadAllGames();
const initialGames = allGames.slice(0, 50);

// Extract unique YYYY-MM prefixes, sorted newest-first, for the initial month dropdown
const monthSet = new Set<string>();
for (const game of allGames) {
  if (game.date && game.date.length >= 7) {
    monthSet.add(game.date.slice(0, 7));
  }
}
const initialMonths = Array.from(monthSet).sort((a, b) => b.localeCompare(a));
---

<Layout>
  <StatsBar games={allGames} />
  <GamesTable
    client:idle
    initialGames={initialGames}
    initialTotal={allGames.length}
    initialMonths={initialMonths}
  />
</Layout>
